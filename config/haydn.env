# Redmi K40 Pro / Mi 11i / POCO F3 Pro (haydn), MIUI 12.0.5.0 R Android 11.
#
# The official Xiaomi haydn-r-oss tree is Linux 5.4.61 and ships device
# configuration as GKI/QGKI fragments, not as a ready-to-make haydn defconfig.
# Xiaomi's QGKI generator first turns every GKI module into a built-in, then
# applies the QGKI fragment before KernelSU and other config changes.

CONFIG_ENV=config/haydn.env

KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource
KERNEL_SOURCE_BRANCH=haydn-r-oss
KERNEL_CONFIG=gki_defconfig
KERNEL_CONFIG_ALLYES_FRAGMENTS=vendor/haydn_GKI.config
KERNEL_CONFIG_FRAGMENTS=vendor/haydn_QGKI.config
KERNEL_IMAGE_NAME=Image
ARCH=arm64
KERNEL_NAME=haydn
ADD_LOCALVERSION_TO_FILENAME=false

# 5.4 QGKI trees are closer to legacy Android kernels than modern GKI 5.10+.
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_LLVM=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
# The Xiaomi 5.4 QGKI audio techpack adds local -Werror flags; keep real
# errors fatal but do not fail on stale-but-harmless unused set variables.
EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error=unused-but-set-variable
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# SukiSU-Ultra builtin carries the KernelSU-side SUSFS support. The local
# haydn patch adapts the kernel-side integration to Xiaomi's 5.4 QGKI tree.
KSU_VARIANT=sukisu-ultra
KSU_REF=builtin
KSU_HOOK_MODE=manual
ENABLE_KPM=false

ENABLE_SUSFS=true
SUSFS_BRANCH=kernel-5.4
SUSFS_REF=76affd70abf61d77feb0a132f61365d6848505df
SUSFS_KERNEL_PATCH=patches/haydn-susfs-5.4.patch

# Linux 5.4 predates path_umount(), which KernelSU uses for mount cleanup.
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=false

ADD_OVERLAYFS_CONFIG=true
ADD_KPROBES_CONFIG=false
DISABLE_LTO=false
DISABLE_CC_WERROR=true
EXTRA_DEFCONFIG=CONFIG_TMPFS_XATTR=y CONFIG_TMPFS_POSIX_ACL=y

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# haydn's stock Android 11 boot image contains a raw Image. Device DTB is in
# vendor_boot.img, so this profile does not require dtbo.img from the kernel
# source build.
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
